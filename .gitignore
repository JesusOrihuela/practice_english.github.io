# ── Development tools ─────────────────────────────────────────
# tools/ is tracked (content audit + audio generation scripts) so CI can run
# the audits and the toolchain is reproducible. Only its dependencies and
# generated artifacts are ignored.
tools/node_modules/

# Root dev dependencies (Playwright smoke suite — see tests/)
node_modules/

# ── Generated files ────────────────────────────────────────────
# Audio manifest generated by tools/generate-audio.mjs
shared/audio/.manifest.json

# ── Content-source corpora (tools/sources) ────────────────────
# Raw corpora (Tatoeba CC-BY, FrequencyWords CC BY-SA) and their derived
# frequency indexes / reconcile reports / candidate pools are large and/or carry
# share-alike terms — not committed to this MIT repo. Regenerate locally with
# tools/sources/fetch-sources.sh then tools/sources/build-freq-inventory.mjs.
# See CREDITS.md for attribution. The hand-authored inventory + provenance
# artifacts (per-topic sustento) ARE kept; freq indexes / reconcile reports /
# candidate pools are regenerable and stay ignored.
tools/sources/raw/
tools/sources/derived/*
!tools/sources/derived/pcic-greetings.json
!tools/sources/derived/pcic-*.json
!tools/sources/derived/core-inventory-*.json
!tools/sources/derived/*-provenance.json
!tools/sources/derived/ngsl-*.json

# ── Audio files (pre-generated, ~399 MB) ──────────────────────
# Generated locally with: node tools/generate-audio.mjs
# Included in the repo so users get instant playback without downloading the TTS model.
# shared/audio/

# ── Editor & IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Claude Code ───────────────────────────────────────────────
.claude/
CLAUDE.md

